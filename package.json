{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static toolbox on GitHub Pages: shared cloud clipboard + DeepSeek chat, backed by Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/db-test.mjs",
    "test:function": "node scripts/function-local.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:all": "npm test && npm run test:db && npm run test:function && npm run test:worker && npm run test:browser",
    "check:generated": "node scripts/defaults-sync.mjs --check && node scripts/pow-vendor.mjs --check",
    "db:push": "node scripts/db-push.mjs",
    "db:status": "node scripts/db-push.mjs --status",
    "defaults:sync": "node scripts/defaults-sync.mjs",
    "defaults:check": "node scripts/defaults-sync.mjs --check",
    "pow:vendor": "node scripts/pow-vendor.mjs",
    "pow:check": "node scripts/pow-vendor.mjs --check",
    "allowlist": "node scripts/allowlist.mjs",
    "secrets:sync": "node scripts/secrets-sync.mjs",
    "deepseek:credential": "node scripts/deepseek-credential.mjs",
    "worker:start": "node scripts/deepseek-worker.mjs",
    "worker:once": "node scripts/deepseek-worker.mjs --once",
    "deepseek:upstream": "node scripts/deepseek-pow-node.mjs",
    "deepseek:relay": "node scripts/browser-relay.mjs",
    "deepseek:login": "node scripts/deepseek-login.mjs",
    "functions:deploy": "node scripts/functions-deploy.mjs",
    "pages:deploy": "node scripts/pages-deploy.mjs",
    "pages:publish": "node scripts/pages-publish.mjs",
    "test:worker": "node scripts/worker-test.mjs",
    "relay:install": "node scripts/relay-service.mjs install",
    "relay:start": "node scripts/relay-service.mjs start",
    "relay:stop": "node scripts/relay-service.mjs stop",
    "relay:status": "node scripts/relay-service.mjs status",
    "relay:logs": "node scripts/relay-service.mjs logs",
    "test:live": "node scripts/live-smoke.mjs",
    "admin:secret": "node scripts/admin-secret.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "codemirror": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "pg": "^8.0.0",
    "playwright": "^1.64.0",
    "supabase": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
