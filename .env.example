# Copy to .env.local (git-ignored) and fill in. Nothing here is ever committed.
#
#   cp .env.example .env.local && chmod 600 .env.local

# --- Supabase (dashboard → Project Settings → API) -------------------------------------
TOOLS_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
TOOLS_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
TOOLS_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
TOOLS_SUPABASE_DB_PASSWORD=...

# Optional: override the Postgres endpoint used by scripts/db-*.mjs.
# Direct connections (db.<ref>.supabase.co) are IPv6-only on newer projects; if this
# machine has no IPv6, use the session pooler instead:
#   TOOLS_DB_HOST=aws-0-<region>.pooler.supabase.com
#   TOOLS_DB_USER=postgres.<ref>
# TOOLS_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# TOOLS_DB_SSL=disable

# --- clipboard allowlist ---------------------------------------------------------------
# "label:password" pairs, comma separated. scripts/allowlist.mjs hashes them with bcrypt
# inside Postgres; the plaintext never reaches the repo.
TOOLS_CLIPBOARD_PASSWORDS=shared:change-me-please

# --- GitHub (Pages deploy + scripts/pages-deploy.mjs) ----------------------------------
# Fine-grained PAT needs: repo (write) + pages (write).
TOOLS_GH_TOKEN=github_pat_...
TOOLS_GH_REPO=Irade-tqy/tools

# --- Supabase CLI (only needed for functions deploy / secrets) -------------------------
# Dashboard → Account → API Keys → Personal access token.
# SUPABASE_ACCESS_TOKEN=sbp_...

# --- DeepSeek transport (server-side secrets; never committed) -------------------------
# These live in Supabase's Edge Function secret store (npm run secrets:sync), NOT here,
# unless you want scripts/secrets-sync.mjs to read them from this file.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_WEB_COOKIE=
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_EXTRA_HEADERS={}
